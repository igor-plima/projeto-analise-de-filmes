      "name": "01 - POST criar filme",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/filmes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "filmes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Cidade de Deus\",\n  \"sinopse\": \"A vida de jovens em uma comunidade do Rio de Janeiro entre as décadas de 1960 e 1980.\",\n  \"genero\": \"Drama\",\n  \"anoLancamento\": 2002\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"filmeId\", pm.response.json().id);",
              "pm.test(\"Header Location presente\", function () { pm.response.to.have.header(\"Location\"); });"
            ]
          }
        }
      ]
    },
